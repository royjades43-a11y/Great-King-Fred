   "beats": [
    {
     "id": "b18",
     "say": "There's actually a name for what's happening physically."
    },
    {
     "id": "b19",
     "say": "Researchers call it flooding."
    },
    {
     "id": "b20",
     "say": "Your heart rate spikes, your thinking narrows, and your body starts treating the argument like an actual threat."
    },
    {
     "id": "b21",
     "say": "Once you're flooded, calm conversation isn't really on the table anymore."
    },
    {
     "id": "b22",
     "say": "Your brain's too busy dealing with stress to form a thoughtful sentence."
    },
    {
     "id": "b23",
     "say": "So no, the silence doesn't mean they don't care."
    },
    {
     "id": "b24",
     "say": "It means their system just took talking off the menu for a minute."
    }
   ],
