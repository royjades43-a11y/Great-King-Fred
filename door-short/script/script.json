{
 "title": "Blame the Door",
 "scenes": [
  {
   "id": "short",
   "tail": 0.2,
   "beats": [
    {
     "id": "b00",
     "say": "You walk into a room."
    },
    {
     "id": "b01",
     "say": "And you forget why."
    },
    {
     "id": "b02",
     "say": "Blame the door."
    },
    {
     "id": "b03",
     "say": "In twenty eleven, psychologist Gabriel Radvansky had people carry objects from table to table."
    },
    {
     "id": "b04",
     "say": "Some walked through a doorway."
    },
    {
     "id": "b05",
     "say": "Others walked the same distance inside one room."
    },
    {
     "id": "b06",
     "say": "The doorway group forgot more."
    },
    {
     "id": "b07",
     "say": "Here's why."
    },
    {
     "id": "b08",
     "say": "Your brain stores your day in chapters."
    },
    {
     "id": "b09",
     "say": "A doorway is a page break."
    },
    {
     "id": "b10",
     "say": "New room, new chapter."
    },
    {
     "id": "b11",
     "say": "And the reason you came in?"
    },
    {
     "id": "b12",
     "say": "It stayed in the last one."
    },
    {
     "id": "b13",
     "say": "So it's not your memory failing."
    },
    {
     "id": "b14",
     "say": "It's your brain turning the page."
    },
    {
     "id": "b15",
     "say": "Be kind to yourself the next time you walk into a room."
    }
   ],
