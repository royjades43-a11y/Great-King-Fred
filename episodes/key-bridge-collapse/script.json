            },
            {
              "clock": "1:27:02",
              "feet": 1500,
              "note": "Port anchor ordered",
              "drift": 0.3
            }
          ],
          "at": "The bridge was 1,500 feet away."
        }
      ]
    },
    {
      "id": "b28",
      "narration": "Two seconds later, the Dali blacked out again, high voltage and low. Starved of fuel, both running generators dropped off the line.",
      "visual": {
        "kind": "power",
        "steps": [
          {
            "clock": "1:27:03",
            "label": "Generators 3 and 4 online",
            "on": [
              "DG3",
              "DG4",
              "HV",
              "TR",
              "LV",
              "STEER",
              "COOL",
              "LIGHTS"
            ]
          },
          {
