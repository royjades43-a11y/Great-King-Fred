        {
          "kind": "footage",
          "assets": [
            "broll-yard-excavator-shear"
          ],
          "at": "It does not explain"
        }
      ]
    },
    {
      "id": "b54",
      "narration": "In 1980, a freighter struck Florida's Sunshine Skyway Bridge, and 35 people died. By 1991, national guidance recommended checking older bridges for ship-strike risk.",
      "visuals": [
        {
          "kind": "stamp",
          "text": "1980",
          "assets": [
            "mir-fig38-sunshine-skyway-1980"
          ],
          "subtext": "Sunshine Skyway Bridge, Florida"
        },
        {
          "kind": "footage",
          "assets": [
            "mir-fig40-i40-bridge-collapse"
          ],
          "label": "Interstate 40 bridge, Oklahoma · NTSB",
          "at": "By 1991,"
        }
      ]
    },
    {
      "id": "b55",
      "narration": "Also in 1980, the 390-foot Blue Nagoya hit Pier 17's fender. The fender stopped it, and was rebuilt to its original design. The Dali was ten times its size.",
      "visuals": [
        {
          "kind": "evidence",
          "heading": "Pier 17, 1980",
          "items": [
