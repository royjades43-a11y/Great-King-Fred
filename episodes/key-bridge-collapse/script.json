        },
        {
          "kind": "footage",
          "assets": [
            "broll-coast-guard-salute-water"
          ],
          "at": "and two of their co-workers."
        }
      ]
    },
    {
      "id": "b69",
      "narration": "A cable-stayed replacement is expected to open in late 2030, at an estimated 4.3 to 5.2 billion dollars.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-crane-barge-approach-span"
          ]
        },
        {
          "kind": "stamp",
          "text": "Late 2030",
          "assets": [
            "broll-port-river-sunset-aerial"
