          "at": "The last of the six men"
        }
      ]
    },
    {
      "id": "b37",
      "chapter": "The investigation",
      "narration": "The National Transportation Safety Board, the NTSB, was on scene that day, with its chair, Jennifer Homendy.",
      "visual": {
        "kind": "footage",
        "assets": [
          "ntsb-aerial-dali-truss-across-bow"
        ],
        "label": "NTSB drone"
      }
    },
    {
      "id": "b38",
      "narration": "The voyage data recorder had stopped logging ship data at 1:25 and 3 seconds. Investigators rebuilt the final minutes from its audio, cameras and alarm logs.",
      "visuals": [
        {
          "kind": "stamp",
