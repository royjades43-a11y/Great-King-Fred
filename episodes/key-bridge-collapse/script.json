              "value": 0.002921,
              "display": "0.002921",
              "highlight": true
            }
          ],
          "note": "Almost 30 times the threshold · NTSB MIR-25-40, p. 135"
        }
      ]
    },
    {
      "id": "b58",
      "narration": "The nearest protective dolphins stood about 489 feet from the piers. The Dali touched none of them.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "prelim-fig07-route-after-blackout"
          ],
          "label": "Dolphins 1 and 2 · NTSB graphic"
        },
        {
          "kind": "footage",
          "assets": [
            "mir-figE1-dali-under-truss"
          ],
          "label": "NTSB",
          "at": "The Dali touched none of them."
        }
      ]
    },
    {
      "id": "b59",
      "narration": "And the workers. The inspector had swapped phone numbers with the police officers. But when the order came, the police officers did not call the inspector.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-police-hood-lights-radio"
          ]
        },
        {
          "kind": "document",
          "source": "NTSB MIR-25-40, p. 177",
          "quote": "when the call came in for the police officers to shut down the bridge to roadway traffic, the police officers did not call the inspector.",
          "highlight": "the police officers did not call the inspector",
          "at": "But when the order came,"
        }
      ]
    },
    {
      "id": "b60",
      "narration": "Warned when the police were, the crew would have had one minute and 16 seconds, perhaps enough to drive to a part of the bridge that stayed up.",
      "visuals": [
        {
          "kind": "stamp",
          "text": "1:16",
          "assets": [
            "broll-px-night-highway-river-aerial"
          ],
          "subtext": "Time to drive clear"
        },
        {
          "kind": "footage",
          "assets": [
            "broll-px-highway-sunset-quiet"
          ],
          "at": "perhaps enough to drive"
        }
      ]
    },
    {
      "id": "b61",
      "narration": "Three failures. A wire never pushed home. A bridge never assessed. A crew never warned.",
      "visual": {
        "kind": "evidence",
        "heading": "Three failures",
        "items": [
          {
            "asset": "mir-fig61-ferrule-arcing-depression",
            "note": "Never pushed home"
