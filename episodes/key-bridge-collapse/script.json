              "LIGHTS"
            ]
          },
          {
            "clock": "1:27:07",
            "label": "Generator 2 starting",
            "on": [
              "DG2",
              "HV",
              "EG",
              "LIGHTS"
            ]
          }
        ]
      }
    },
    {
      "id": "b29",
      "narration": "The senior pilot shouted for the bow thruster. It did not work; its pumps had tripped in the first blackout. And the anchor brake would not open.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-bridge-red-chart-table"
          ]
        },
        {
          "kind": "footage",
          "assets": [
            "broll-er-diesel-crew"
          ],
          "at": "It did not work;"
        },
        {
          "kind": "footage",
          "assets": [
            "broll-anchor-brake-wheel"
          ],
          "at": "And the anchor brake"
        }
      ]
    },
    {
      "id": "b30",
      "narration": "At 1:27 and 53 seconds, police at each end of the bridge were told to stop traffic. Both ends were blocked 48 seconds before impact.",
      "visuals": [
        {
          "kind": "stamp",
          "text": "1:27:53 AM",
          "assets": [
            "broll-dispatcher-headset-screens"
          ],
