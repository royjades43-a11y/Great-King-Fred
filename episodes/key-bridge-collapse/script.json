                "LV",
                "STEER",
                "COOL",
                "FUEL",
                "LIGHTS"
              ]
            },
            {
              "clock": "1:25:00",
              "label": "Breaker HR1 opens",
              "on": [
                "DG3",
                "DG4",
                "HV",
                "ME"
              ]
            }
          ],
          "at": "The ship's low-voltage power"
        }
      ]
    },
    {
      "id": "b19",
      "narration": "All three steering pumps lost power, and most of the lights went out. The bridge was 3.3 ship lengths ahead.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-er-walkway-pump-no2"
          ]
        },
        {
          "kind": "footage",
          "assets": [
            "broll-bridge-red-night-wide"
          ],
          "at": "and most of the lights"
        },
        {
          "kind": "footage",
          "assets": [
            "broll-px-night-port-city-aerial"
          ],
          "at": "The bridge was 3.3"
        }
      ]
    },
    {
      "id": "b20",
      "narration": "Eight seconds later, the main engine shut down on low cooling-water pressure. It would not restart before the impact.",
      "visuals": [
        {
          "kind": "power",
          "steps": [
            {
              "clock": "1:25:00",
              "label": "Low-voltage board dark",
              "on": [
                "DG3",
                "DG4",
                "HV",
                "ME"
              ]
            },
            {
              "clock": "1:25:08",
              "label": "Main engine shuts down",
              "on": [
                "DG3",
                "DG4",
                "HV"
              ]
            }
          ]
        },
        {
          "kind": "footage",
          "assets": [
            "broll-er-hands-tools"
          ],
          "at": "It would not restart"
        }
      ]
    },
    {
      "id": "b21",
      "narration": "The senior pilot asked, \"Do we have steering?\" The answer: \"We have steering.\" But no steering pump had power.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-bridge-radar-consoles-dusk"
          ]
        },
        {
          "kind": "footage",
          "assets": [
            "broll-merchant-bridge-dusk-crew"
          ],
          "at": "The answer:"
        },
        {
          "kind": "footage",
          "assets": [
            "broll-bridge-console-red-controls"
          ],
          "at": "But no steering pump"
        }
      ]
    },
    {
      "id": "b22",
      "narration": "With no engine and the rudder stuck, the ship swung to starboard. The helmsman called it out: \"Swinging to starboard, wheel on hard port sir.\"",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-px-dark-water-ripples"
          ]
        },
        {
          "kind": "footage",
          "assets": [
            "broll-merchant-bridge-window-watch"
          ],
          "at": "the ship swung to starboard."
        },
        {
          "kind": "footage",
          "assets": [
            "broll-bridge-console-hands"
          ],
          "at": "The helmsman called it out:"
        }
      ]
    },
    {
      "id": "b23",
      "narration": "At 1:25 and 58 seconds, the electrician closed the breakers by hand. Power was back after 58 seconds.",
      "visuals": [
        {
          "kind": "stamp",
          "text": "1:25:58 AM",
          "assets": [
            "broll-breaker-red-screwdriver-close"
          ],
          "subtext": "Breakers closed by hand"
        },
        {
          "kind": "power",
          "steps": [
            {
              "clock": "1:25:08",
              "label": "Engine off, low-voltage dark",
              "on": [
                "DG3",
                "DG4",
                "HV"
              ]
            },
            {
              "clock": "1:25:58",
              "label": "Low-voltage power back",
              "on": [
                "DG3",
                "DG4",
                "HV",
                "TR",
                "LV",
                "STEER",
                "COOL",
                "LIGHTS"
              ]
            }
          ],
          "at": "Power was back"
        }
      ]
    },
    {
      "id": "b24",
      "narration": "But the flushing pump, the only fuel supply for the two running generators, did not restart.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-er-white-tank-pump-motors"
          ]
        },
        {
          "kind": "footage",
          "assets": [
            "broll-er-motors-pumps"
          ],
          "at": "the only fuel supply"
        }
      ]
    },
    {
      "id": "b25",
      "narration": "The senior pilot phoned the pilots' dispatcher to get the Key Bridge shut down. The ship was 2,430 feet away.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-dispatch-center-radio"
          ]
        },
        {
          "kind": "route",
