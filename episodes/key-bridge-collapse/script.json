          ],
          "at": "police at each end"
        },
        {
          "kind": "footage",
          "assets": [
            "broll-px-dusk-highway-aerial"
          ],
          "at": "Both ends were blocked"
        }
      ]
    },
    {
      "id": "b31",
      "narration": "At 1:28 and 42 seconds, the anchor finally went down. Seven seconds later, the bow began to swing back to port. Too late.",
      "visuals": [
        {
          "kind": "stamp",
          "text": "1:28:42 AM",
          "assets": [
            "broll-anchor-chain-closeup"
          ],
          "subtext": "Anchor down"
