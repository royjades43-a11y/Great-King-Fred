              "note": "Call to shut the bridge",
              "drift": 0.1
            }
          ],
          "at": "The ship was 2,430 feet away."
        }
      ]
    },
    {
      "id": "b26",
      "narration": "The pilot radioed a tug: \"that's it, hammer down.\" That tug was sixteen minutes away.",
      "visuals": [
        {
          "kind": "footage",
          "assets": [
            "broll-bridge-radar-consoles-dusk2"
          ]
        },
        {
          "kind": "footage",
          "assets": [
            "broll-tug-night-vision"
          ],
          "at": "That tug was sixteen minutes away."
        }
      ]
    },
    {
      "id": "b27",
      "narration": "At 1:27 and 2 seconds, the senior pilot ordered the port anchor. The bridge was 1,500 feet away.",
      "visuals": [
        {
          "kind": "stamp",
          "text": "1:27:02 AM",
          "assets": [
            "broll-chain-locker-crew"
          ],
          "subtext": "Port anchor ordered"
        },
        {
          "kind": "route",
          "keyframes": [
            {
