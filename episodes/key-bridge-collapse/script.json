            "on": [
              "DG3",
              "DG4",
              "HV",
              "ME"
            ]
          },
          {
            "clock": "1:25:08",
            "label": "Engine and steering gone",
            "on": [
              "DG3",
              "DG4",
              "HV"
            ]
          }
        ]
      }
    },
    {
      "id": "b51",
      "narration": "The breakers were set to manual. In automatic, power would have been back in about ten seconds, not 58.",
      "visual": {
        "kind": "chart",
        "title": "Time to restore power",
        "bars": [
          {
            "label": "Breakers in automatic (NTSB estimate)",
            "value": 10,
